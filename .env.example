# === Neon Postgres ===
DOCBOT_DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/docbot?sslmode=require

# === OpenAI ===
DOCBOT_OPENAI_API_KEY=sk-your-openai-api-key-here
DOCBOT_EMBEDDING_MODEL=text-embedding-3-small
DOCBOT_RAG_MODEL=gpt-5.2

# === Chunking ===
DOCBOT_CHUNK_TARGET_TOKENS=750
DOCBOT_CHUNK_MIN_TOKENS=200
DOCBOT_CHUNK_MAX_TOKENS=900

# === Search ===
DOCBOT_SEARCH_TOP_K=10
DOCBOT_SIMILARITY_THRESHOLD=0.7

# === RAG ===
DOCBOT_RAG_MAX_CONTEXT_CHUNKS=8
DOCBOT_RAG_TEMPERATURE=0.1

# === Ingesta unificada desde knowledge-web (export HTTP) ===
# URL del endpoint de export de knowledge-web y su token Bearer.
DOCBOT_KB_EXPORT_URL=
DOCBOT_KB_EXPORT_TOKEN=

# === Auth opcional para POST /sync ===
# Si se define, POST /sync exige "Authorization: Bearer <token>". Si se deja
# vacío, /sync queda sin auth (comportamiento actual).
DOCBOT_SYNC_TOKEN=

# === Auth para rutas /admin/* (gestión de prompts, conversaciones, feedback) ===
# Requerido para que el panel /admin/docbot de knowledge-web pueda gestionar el agente.
# Si se deja vacío, las rutas /admin/* devuelven 503 (deshabilitadas).
DOCBOT_ADMIN_TOKEN=

# === Auth proxy→agente para /chat (scoping por rol) ===
# Secreto compartido con knowledge-web (su DOCBOT_PROXY_TOKEN). Si se define, /chat
# exige el header X-ZeroQ-Proxy-Token; sin él responde 401 (evita saltear el scoping
# llamando al agente directo). Los dominios permitidos llegan en X-ZeroQ-Scopes.
DOCBOT_PROXY_TOKEN=

# === CORS (separar múltiples orígenes con coma) ===
DOCBOT_CORS_ORIGINS=*

# === API ===
DOCBOT_API_HOST=0.0.0.0
DOCBOT_API_PORT=8000
